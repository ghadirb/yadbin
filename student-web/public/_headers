/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

# Public legal / support pages (linked from the app and the Myket listing): static, no scripts, indexable.
/privacy*
  ! X-Robots-Tag
/terms*
  ! X-Robots-Tag
/support*
  ! X-Robots-Tag
/legal.css
  ! X-Robots-Tag
