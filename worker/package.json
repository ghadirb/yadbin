{
  "name": "yadbin-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply yadbin-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yadbin-db --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  }
}
